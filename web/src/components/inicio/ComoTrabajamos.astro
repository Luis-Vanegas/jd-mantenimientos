---
// Proceso de atención en cuatro pasos numerados. Los textos vienen de `pasos`.
import Icono from '../Icono.astro';
import { pasos } from '../../data/empresa';
---
<section class="section" id="como-trabajamos" aria-labelledby="pasos-titulo">
  <div class="wrap distribucion">
    <div>
      <p class="kicker">Cómo trabajamos</p>
      <h2 class="section-title" id="pasos-titulo">Es muy fácil</h2>
      <p class="section-lead">Te acompañamos en cada paso para que tu proyecto sea un éxito.</p>
    </div>

    <ol class="pasos">
      {pasos.map((paso, indice) => (
        <li>
          <span class="numero" aria-hidden="true">{indice + 1}</span>
          <Icono nombre={paso.icono} />
          <h3>{paso.titulo}</h3>
          <p>{paso.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .distribucion {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
    gap: 40px;
    align-items: start;
  }

  .pasos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  li {
    position: relative;
    padding-top: 4px;
  }

  /* Conector entre pasos; se oculta en el último y cuando la grilla se apila. */
  li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 18px;
    left: 48px;
    right: -12px;
    height: 1px;
    background: var(--line);
  }

  .numero {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 700;
  }

  li .icono {
    width: 30px;
    height: 30px;
    margin-top: 16px;
    color: var(--blue);
  }

  h3 {
    margin-top: 12px;
    font-size: 1.02rem;
    font-weight: 700;
  }

  li p {
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  @media (max-width: 960px) {
    .distribucion { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .pasos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    li::after { display: none; }
  }
</style>
