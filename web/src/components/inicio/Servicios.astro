---
// Catálogo de servicios: la primera foto abre la lista y las demás acompañan cada descripción.
import { Image } from 'astro:assets';
import Icono from '../Icono.astro';
import { empresa, servicios } from '../../data/empresa';
---
<section class="section servicios" id="servicios" aria-labelledby="servicios-titulo">
  <div class="wrap">
    <header class="cabecera">
      <div>
        <p class="kicker">Nuestros servicios</p>
        <h2 class="section-title" id="servicios-titulo">
          Servicios que mantienen<br /><em>tu espacio en las mejores condiciones</em>
        </h2>
        <p class="section-lead">
          Personal capacitado y equipos especializados para un servicio eficiente, seguro y de calidad.
        </p>
      </div>
      <a class="enlace" href={empresa.whatsappHref} target="_blank" rel="noopener noreferrer">
        Cotizar un servicio <Icono nombre="arrow" />
      </a>
    </header>

    <ul class="grilla">
      {servicios.map((servicio, indice) => (
        <li class="tarjeta">
          <Image
            src={servicio.imagen}
            alt={servicio.imagenAlt}
            widths={[400, 640]}
            sizes={indice === 0 ? '(max-width: 760px) 100vw, 48vw' : '128px'}
            loading="lazy"
          />
          <div class="cuerpo">
            <Icono nombre={servicio.icono} />
            <h3>{servicio.titulo}</h3>
            <p>{servicio.texto}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .servicios { background: var(--surface); }

  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .enlace {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .enlace:hover { color: var(--blue-bright); }

  .grilla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(24px, 5vw, 72px);
    margin-top: 28px;
  }

  .tarjeta {
    display: grid;
    grid-template-columns: clamp(64px, 12vw, 128px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    padding-block: 14px;
    border-top: 1px solid var(--line);
  }

  .tarjeta:first-child {
    display: block;
    grid-row: span 4;
    padding: 0 0 18px;
    border-top: 0;
  }

  .tarjeta img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .tarjeta:first-child img { aspect-ratio: 16 / 10; }
  .tarjeta:first-child .cuerpo { margin-top: 16px; }

  .cuerpo {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 4px 10px;
  }

  .cuerpo :global(.icono) {
    width: 20px;
    height: 20px;
    color: var(--blue);
  }

  h3 {
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .cuerpo p {
    grid-column: 2;
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  @media (max-width: 760px) {
    .grilla { grid-template-columns: 1fr; }
    .tarjeta:first-child { grid-row: auto; }
  }
</style>
