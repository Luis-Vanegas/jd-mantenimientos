---
// Franja de contacto con la acción principal y los datos de la empresa.
import Icono from '../Icono.astro';
import { empresa } from '../../data/empresa';
---
<section class="banda" aria-labelledby="banda-titulo">
  <div class="wrap contenido">
    <div class="mensaje">
      <Icono nombre="helmet" class="casco" />
      <div>
        <h2 id="banda-titulo">¿Necesitas materiales o un técnico?</h2>
        <p>Escríbenos por WhatsApp y recibe asesoría inmediata.</p>
      </div>
    </div>
    <div class="accion">
      <a class="btn btn-whatsapp" href={empresa.whatsappHref} target="_blank" rel="noopener noreferrer">
        <Icono nombre="wa" />
        Solicitar por WhatsApp
      </a>
      <small>Rápido · Fácil · Sin complicaciones</small>
    </div>
  </div>

  <ul class="wrap datos-contacto">
    <li>
      <Icono nombre="mail" />
      <div>
        <strong>Correo</strong>
        <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>
      </div>
    </li>
    <li>
      <Icono nombre="pin" />
      <div>
        <strong>Ubicación</strong>
        <p>{empresa.direccion}, {empresa.ciudad}</p>
      </div>
    </li>
  </ul>
</section>

<style>
  .banda {
    background: var(--navy-2);
    color: var(--white);
  }

  .contenido {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding-block: 36px 24px;
  }

  .mensaje {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .casco {
    width: 56px;
    height: 56px;
    color: var(--accent);
    stroke-width: 1.4;
  }

  h2 {
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .mensaje p { margin-top: 6px; color: var(--ink-on-dark); }

  .accion {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .accion .btn { min-height: 54px; padding-inline: 28px; font-size: 1rem; }
  .accion small { font-size: 0.82rem; color: var(--ink-on-dark-2); }

  .datos-contacto {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    padding-block: 18px 28px;
    border-top: 1px solid var(--line-dark);
  }

  .datos-contacto li { display: flex; gap: 10px; min-width: 0; }
  .datos-contacto :global(.icono) { margin-top: 2px; color: var(--accent); }
  .datos-contacto strong { display: block; font-size: 0.875rem; }
  .datos-contacto :is(a, p) { color: var(--ink-on-dark); overflow-wrap: anywhere; }
  .datos-contacto a { text-decoration: underline; text-underline-offset: 0.2em; }

  @media (max-width: 560px) {
    .casco { display: none; }
    .accion, .accion .btn { width: 100%; }
  }
</style>
